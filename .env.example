# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_AC_SERIES_ID=your-assetto-corsa-series-uuid
VITE_AC_SERIES_NAME=Assetto Corsa

# Server-only Netlify configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Shared-admin authentication.
# Do not expose either value with a VITE_ prefix.
SIMR_ADMIN_PASSWORD=choose-a-new-shared-password
SIMR_SESSION_SECRET=generate-a-long-random-secret
